# ==========================================
# CONFIGURACIÓN DE NEXUS STUDIO (BACKEND)
# ==========================================

# Modo de motor: "github" para que dispare tu GitHub Action
ENGINE_MODE=github

# Tu token de GitHub (el que empieza con ghp_...)
GITHUB_TOKEN=tu_token_ghp_aqui

# Tu repositorio exacto
GITHUB_REPO=mauriciojmnz10-max/nexus-viral-core

# El nombre de tu archivo de workflow (lo crearemos en el paso 3)
GITHUB_WORKFLOW=render.yml
GITHUB_REF_NAME=main

# Seguridad (La clave que inventaste)
NEXUS_API_KEY=Nexv1006

# CORS: Permite que Vercel (o tu localhost) hable con el backend
ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app
